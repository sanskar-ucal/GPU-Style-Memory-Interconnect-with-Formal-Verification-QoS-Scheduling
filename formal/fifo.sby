# Unbounded proof (k-induction) of request-queue FIFO properties:
#   occupancy bound, flag consistency, ordering + data integrity
[tasks]
prove
cover
bug_fifo_overflow prove

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 16

[engines]
smtbmc yices

[script]
bug_fifo_overflow: read -define BUG_FIFO_OVERFLOW
read -formal sync_fifo.sv
chparam -set WIDTH 8 -set DEPTH 4 sync_fifo
prep -top sync_fifo

[files]
../rtl/sync_fifo.sv
