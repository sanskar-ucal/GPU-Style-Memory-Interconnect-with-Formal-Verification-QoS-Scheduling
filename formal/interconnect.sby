# Bounded model check of the full fabric (queues + arbiter + FSM + routing):
#   AXI VALID-hold / payload stability on every outbound channel,
#   single-owner routing on R/W/B, reset recovery, plus all sub-block props
[tasks]
bmc
cover
bug_fifo_overflow bmc
bug_arb_double_grant bmc
bug_rr_no_rotate bmc
bug_handshake_drop bmc
bug_r_misroute bmc
bug_reset_fsm bmc

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 24

[engines]
smtbmc yices

[script]
bug_fifo_overflow: read -define BUG_FIFO_OVERFLOW
bug_arb_double_grant: read -define BUG_ARB_DOUBLE_GRANT
bug_rr_no_rotate: read -define BUG_RR_NO_ROTATE
bug_handshake_drop: read -define BUG_HANDSHAKE_DROP
bug_r_misroute: read -define BUG_R_MISROUTE
bug_reset_fsm: read -define BUG_RESET_FSM
read -formal sync_fifo.sv qos_arbiter.sv axi_interconnect.sv
chparam -set N 4 -set ADDR_W 8 -set DATA_W 8 -set ID_W 2 -set FIFO_DEPTH 2 -set WW 2 axi_interconnect
prep -top axi_interconnect

[files]
../rtl/sync_fifo.sv
../rtl/qos_arbiter.sv
../rtl/axi_interconnect.sv
